#!/bin/sh
# Sets guacadmin to a new random password (written to /root/.guacamole-admin-initial).
set -eu
umask 077
pw=$(openssl rand -base64 18 | tr -d '/+=')
salt=$(openssl rand -hex 32)
hash=$(printf '%s%s' "$pw" "$(printf '%s' "$salt" | tr 'a-f' 'A-F')" | openssl dgst -sha256 -hex | awk '{print $NF}')
docker compose -f {{ app_guac_dir }}/docker-compose.yml exec -T postgres psql -U guacamole guacamole -v ON_ERROR_STOP=1 -c \
  "UPDATE guacamole_user SET password_hash=decode('$hash','hex'), password_salt=decode('$salt','hex'), password_date=now() WHERE entity_id=(SELECT entity_id FROM guacamole_entity WHERE name='guacadmin' AND type='USER');"
printf 'guacadmin %s\n' "$pw" > /root/.guacamole-admin-initial
