# homelab-apps (infra host/apps-runner, Class C): runner-apps may start one app play via the root wrapper, nothing else.
# CT 300 runs sudo-rs (no argument wildcards; env is always reset). The wrapper itself refuses anything but exactly
# one all-digit argument and sets its own PATH.
runner-apps ALL=(root) NOPASSWD: /usr/local/sbin/apps-play-run
