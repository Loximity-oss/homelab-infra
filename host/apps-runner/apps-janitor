#!/usr/bin/python3 -I
"""apps-janitor — root timer on hm1-shr-cicd01 (CT 300), every 10 minutes. Class C (proposal 5b-security.md, #127).

1. Run dirs /run/devops/apps/<run-id>: a non-directory or symlink entry is unlinked; a directory older than
   MAX_AGE whose unit apps-play-<run-id> is not running is removed with `find -xdev -depth -delete` (never follows
   symlinks, stays on one filesystem). Its ssh-agent is killed first, by the pid recorded in agent.pid, and only if
   that process belongs to runner-apps and is ssh-agent serving that run dir's socket.
2. Orphan agents: a runner-apps ssh-agent whose `-a` socket lies under a run dir that no longer exists is killed
   (by pid, after checking owner, exe and socket path; never by name alone).
3. Host lock files: for every guest spec on infra main (read from Gitea's own bare repo, no token), make sure
   /var/lib/devops/locks/host-<hostname>.lock and .owner exist, owned root:devops-locks, mode 0664. Root-owned files
   are the only ones every runner can open in the sticky locks dir (fs.protected_regular=2). Never deletes a lock.
Nobody clears locks or run dirs by hand. Log: journalctl -t apps-janitor.
"""
import os, pwd, grp, re, signal, stat, subprocess, syslog, time

RUN_ROOT = "/run/devops/apps"
MAX_AGE = 14400 + 600                     # longest job timeout + margin
LOCKS = "/var/lib/devops/locks"
INFRA_GIT = "/var/lib/gitea/data/gitea-repositories/homelab/homelab-infra.git"
HOST_RE = re.compile(r"^hm1-(dmz|shr|int|stg|wifi|iot)-[a-z][a-z0-9]*[0-9]{2}$")
SPEC_RE = re.compile(r"^terraform/stacks/[a-z0-9]+/[a-z]+/guests/([a-z0-9-]+)\.yaml$")
OWNER_UID = pwd.getpwnam("runner-apps").pw_uid
LOCK_GID = grp.getgrnam("devops-locks").gr_gid
syslog.openlog("apps-janitor")


def log(msg):
    syslog.syslog(msg)
    print(msg)


def proc_info(pid):
    try:
        uid = int(next(l.split()[1] for l in open(f"/proc/{pid}/status") if l.startswith("Uid:")))
        exe = os.path.basename(os.readlink(f"/proc/{pid}/exe"))
        argv = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        return uid, exe, [a.decode(errors="replace") for a in argv if a]
    except (OSError, StopIteration, ValueError):
        return None


def agent_socket(argv):
    return argv[argv.index("-a") + 1] if "-a" in argv[:-1] else None


def kill_agent(pid, rundir):
    info = proc_info(pid)
    if not info:
        return
    uid, exe, argv = info
    sock = agent_socket(argv) or ""
    if uid == OWNER_UID and exe == "ssh-agent" and os.path.dirname(sock) == rundir:
        os.kill(pid, signal.SIGTERM)
        log(f"killed ssh-agent pid {pid} of {rundir}")


def unit_running(rid):
    return subprocess.run(["systemctl", "is-active", "--quiet", f"apps-play-{rid}.service"]).returncode == 0


def clean_run_dirs():
    if not os.path.isdir(RUN_ROOT) or os.path.islink(RUN_ROOT):
        return
    now = time.time()
    for e in os.scandir(RUN_ROOT):
        p = e.path
        st = os.lstat(p)
        if not stat.S_ISDIR(st.st_mode):
            os.unlink(p)
            log(f"removed non-directory entry {p}")
            continue
        if now - st.st_mtime < MAX_AGE or (e.name.isdigit() and unit_running(e.name)):
            continue
        try:
            fd = os.open(os.path.join(p, "agent.pid"), os.O_RDONLY | os.O_NOFOLLOW)
            try:
                if stat.S_ISREG(os.fstat(fd).st_mode):
                    kill_agent(int(os.read(fd, 32).decode().strip()), p)
            finally:
                os.close(fd)
        except (OSError, ValueError):
            pass
        subprocess.run(["find", p, "-xdev", "-depth", "-delete"], check=False)
        log(f"removed stale run dir {p} (age {int(now - st.st_mtime)} s)")


def kill_orphan_agents():
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        info = proc_info(int(d))
        if not info or info[0] != OWNER_UID or info[1] != "ssh-agent":
            continue
        sock = agent_socket(info[2])
        if sock and os.path.dirname(os.path.dirname(sock)) == RUN_ROOT and not os.path.isdir(os.path.dirname(sock)):
            kill_agent(int(d), os.path.dirname(sock))


def ensure_locks():
    try:
        names = subprocess.run(["git", "-c", "safe.directory=*", f"--git-dir={INFRA_GIT}", "ls-tree", "-r",
                                "--name-only", "main", "--", "terraform/stacks"],
                               capture_output=True, text=True, check=True).stdout.splitlines()
    except subprocess.CalledProcessError as e:
        log(f"cannot read infra main: {e.stderr.strip()}")
        return
    hosts = sorted({m.group(1) for n in names if (m := SPEC_RE.match(n)) and HOST_RE.match(m.group(1))})
    for h in hosts:
        for suffix in ("lock", "owner"):
            p = os.path.join(LOCKS, f"host-{h}.{suffix}")
            try:
                fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o664)
                os.fchown(fd, 0, LOCK_GID)
                os.fchmod(fd, 0o664)
                os.close(fd)
                log(f"created {p}")
                continue
            except FileExistsError:
                pass
            st = os.lstat(p)
            if not stat.S_ISREG(st.st_mode):
                log(f"WARNING {p} is not a regular file; left alone")
            elif (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) != (0, LOCK_GID, 0o664):
                fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
                os.fchown(fd, 0, LOCK_GID)
                os.fchmod(fd, 0o664)
                os.close(fd)
                log(f"fixed owner/mode of {p}")


if __name__ == "__main__":
    clean_run_dirs()
    kill_orphan_agents()
    ensure_locks()
