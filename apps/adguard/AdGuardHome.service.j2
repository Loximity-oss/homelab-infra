[Unit]
Description=AdGuard Home DNS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_adguard_user }}
WorkingDirectory={{ app_adguard_dir }}
ExecStart={{ app_adguard_dir }}/AdGuardHome --no-check-update -c {{ app_adguard_dir }}/AdGuardHome.yaml -w {{ app_adguard_dir }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
