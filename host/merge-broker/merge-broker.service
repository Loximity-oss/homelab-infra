[Unit]
Description=Merge broker: the only automated merger of homelab-infra and homelab-apps (infra #135)
After=network-online.target gitea.service
[Service]
Type=oneshot
User=runner
Group=runner
Environment=HOME=/var/lib/merge-broker PATH=/usr/local/bin:/usr/bin:/bin
StateDirectory=merge-broker
ExecStart=/usr/local/sbin/merge-broker
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
