# L4 app checks for role dns = AdGuard Home on {{ inventory_hostname }}. Rendered by ansible/roles/verify for every guest
# whose spec role is `dns` (file name = role code); run by the nightly/on-demand verify and after each apply.
# Read-only: nothing here changes the guest. No credentials (the AdGuard admin API is not used). Loopback only.
# Values: ansible/playbooks/group_vars/role_dns.yml is loaded for role_dns in the verify play too, so filters and ports
# are the ones app_adguard deploys. Not loaded -> render error -> no L4 result -> verify.py reports a failure.
# Paths are app_adguard role DEFAULTS (not loaded by the verify play): same literals as fallback, keep in sync with
# ansible/roles/app_adguard/defaults/main.yml (a mismatch fails loudly, file not found; it never passes falsely).
# Listeners are checked with ss, not Goss port: AdGuard (Go) on 0.0.0.0 opens dual-stack [::] sockets that Goss
# tcp:/udp: (IPv4 table only) would miss.
{% set adguard_dir = app_adguard_dir | default('/opt/AdGuardHome') %}
{% set adguard_conf = app_adguard_conf_dir | default(adguard_dir ~ '/conf') %}
{% set adguard_drift = app_adguard_drift_script | default('/usr/local/sbin/hm1-adguard-drift') %}
{% set adguard_filters = app_adguard_filters | selectattr('enabled') | list %}
service:
  AdGuardHome:
    enabled: true
    running: true
command:
  app-dns-listen-tcp53:
    exec: 'n=$(ss -Hltnp "sport = :{{ app_adguard_dns_port }}" | grep -c AdGuardHome); echo "AdGuardHome tcp/{{ app_adguard_dns_port }} listeners: $n"; test "$n" -gt 0'
    exit-status: 0
  app-dns-listen-udp53:
    exec: 'n=$(ss -Hlunp "sport = :{{ app_adguard_dns_port }}" | grep -c AdGuardHome); echo "AdGuardHome udp/{{ app_adguard_dns_port }} listeners: $n"; test "$n" -gt 0'
    exit-status: 0
  app-dns-listen-webui:
    exec: 'n=$(ss -Hltnp "sport = :{{ app_adguard_http_port }}" | grep -c AdGuardHome); echo "AdGuardHome tcp/{{ app_adguard_http_port }} listeners: $n"; test "$n" -gt 0'
    exit-status: 0
  app-dns-webui-http:
    exec: 'c=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 http://127.0.0.1:{{ app_adguard_http_port }}/); echo "web UI HTTP $c"; case "$c" in 200|302) exit 0;; *) exit 1;; esac'
    exit-status: 0
  app-dns-query:
    exec: 'a=$(dig +short +time=3 +tries=2 @127.0.0.1 -p {{ app_adguard_dns_port }} example.com A); rc=$?; echo "dig rc=$rc answer: $(echo $a | head -c 120)"; test $rc -eq 0 && echo "$a" | grep -Eq "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$"'
    exit-status: 0
    timeout: 20000
  app-dns-filters-configured:
    exec: 'echo "enabled filters in role_dns.yml: {{ adguard_filters | map(attribute="id") | join(",") or "none" }}"; test {{ adguard_filters | length }} -gt 0'
    exit-status: 0
{% for f in adguard_filters %}
  app-dns-filter-{{ f.id }}-rules:
    exec: 'f={{ adguard_dir }}/data/filters/{{ f.id }}.txt; test -s "$f" || { echo "filter {{ f.id }}: $f missing or empty"; exit 1; }; n=$(grep -cvE "^[[:space:]]*($|!|#|\[)" "$f"); echo "filter {{ f.id }}: $n rules"; test "$n" -gt 0'
    exit-status: 0
{% endfor %}
  app-dns-config-drift:
    exec: 'out=$({{ adguard_drift }} {{ adguard_conf }}/AdGuardHome.yaml.managed {{ adguard_conf }}/AdGuardHome.yaml); rc=$?; echo "drift rc=$rc (0 in sync, 1 drift, 2 cannot compare) $(echo $out | head -c 200)"; test $rc -eq 0'
    exit-status: 0
